@model SecurityDashboardViewModel
@{
    ViewData["Title"] = "Təhlükəsizlik";
    ViewData["Heading"] = "Nəzarət lövhəsi";
    ViewData["Active"] = "security";

    (string, string) EmpPr(string s) => s switch
    {
        "in" => ("Binadadır", "in"),
        "onfloor" => ("Mərtəbədə", "onfloor"),
        _ => ("Çıxış etdi", "out")
    };
    (string, string) GstSt(string s) => s switch
    {
        "in" => ("Binadadır", "in"),
        "onfloor" => ("Mərtəbədə", "onfloor"),
        "checkedin" => ("Kart verilib", "checkedin"),
        "late" => ("Gecikib", "late"),
        _ => ("Bayırda", "out")
    };
}

<div class="page-head">
  <div><p>Bütün müəssisələrin giriş-çıxış nəzarəti — hazırda binada olan işçilər və qonaqlar (canlı).</p></div>
  <div class="sec-toolbar">
    <span class="chip in">● Canlı</span>
    <div class="field" style="margin:0">
      <label>Müəssisə</label>
      <select id="fCompany" class="input">
        <option value="">Bütün müəssisələr</option>
        @foreach (var c in Model.Companies)
        {
          <option value="@c.Name">@c.Name</option>
        }
      </select>
    </div>
  </div>
</div>

<style>
  .sec-toolbar{display:flex;align-items:end;gap:12px;flex-wrap:wrap}
  .sec-toolbar .chip{align-self:center}
  .sec-toolbar .field .input{min-width:220px;height:40px}
</style>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start">

  <!-- İşçilər (binada) -->
  <section class="panel">
    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--border,#eee)">
      <b>İşçilər (binada)</b><span class="hint" id="empCount" style="color:var(--muted)"></span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Ad Soyad</th><th>Müəssisə / Şöbə</th><th>Vəziyyət</th><th>Son</th></tr></thead>
        <tbody id="secEmp"></tbody>
      </table>
    </div>
    <div id="secEmpEmpty" class="empty-state" style="display:none;padding:22px;text-align:center;color:var(--muted)">Binada işçi yoxdur.</div>
  </section>

  <!-- Qonaqlar (binada) -->
  <section class="panel">
    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--border,#eee)">
      <b>Qonaqlar (binada)</b><span class="hint" id="gstCount" style="color:var(--muted)"></span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Ad Soyad</th><th>Müəssisə</th><th>Qəbul edən</th><th>Vəziyyət</th><th>Giriş / Çıxış</th></tr></thead>
        <tbody id="secGst"></tbody>
      </table>
    </div>
    <div id="secGstEmpty" class="empty-state" style="display:none;padding:22px;text-align:center;color:var(--muted)">Binada qonaq yoxdur.</div>
  </section>
</div>

@section Scripts {
<script>
  const $ = id => document.getElementById(id);
  function esc(s){ return (s ?? '—').toString().replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

  function empChip(p){
    if (p === 'in') return '<span class="chip in">Binadadır</span>';
    if (p === 'onfloor') return '<span class="chip onfloor">Mərtəbədə</span>';
    return '<span class="chip out">Çıxış etdi</span>';
  }
  function gstChip(s){
    if (s === 'in') return '<span class="chip in">Binadadır</span>';
    if (s === 'onfloor') return '<span class="chip onfloor">Mərtəbədə</span>';
    if (s === 'checkedin') return '<span class="chip checkedin">Kart verilib</span>';
    if (s === 'late') return '<span class="chip late">Gecikib</span>';
    return '<span class="chip out">Bayırda</span>';
  }

  let DATA = { employees: [], guests: [] };

  function render(){
    const comp = $('fCompany').value;
    // İşçilər
    const emps = DATA.employees.filter(e => !comp || (e.company || '') === comp);
    $('secEmp').innerHTML = emps.map(e => `
      <tr>
        <td><b>${esc(e.name)}</b> <span class="cell-sub">${esc(e.employeeNo)}</span></td>
        <td class="cell-sub">${esc(e.company)}${e.department ? ' · ' + esc(e.department) : ''}</td>
        <td>${empChip(e.presence)}</td>
        <td class="cell-sub" style="white-space:nowrap">${esc(e.lastSeen)}</td>
      </tr>`).join('');
    $('secEmpEmpty').style.display = emps.length ? 'none' : 'block';
    $('empCount').textContent = emps.length + ' nəfər';
    // Qonaqlar
    const gsts = DATA.guests.filter(g => !comp || (g.company || '') === comp);
    $('secGst').innerHTML = gsts.map(g => `
      <tr>
        <td><b>${esc(g.name)}</b></td>
        <td class="cell-sub">${esc(g.company)}</td>
        <td class="cell-sub">${esc(g.host)}</td>
        <td>${gstChip(g.status)}</td>
        <td class="cell-sub" style="white-space:nowrap">
          <div>Giriş: ${g.entry ? esc(g.entry) : '—'}</div>
          <div class="hint" style="font-size:11px">Çıxış: ${g.exit ? esc(g.exit) : '—'}</div>
        </td>
      </tr>`).join('');
    $('secGstEmpty').style.display = gsts.length ? 'none' : 'block';
    $('gstCount').textContent = gsts.length + ' nəfər';
  }

  async function poll(){
    try {
      const res = await fetch('/Security/Feed', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      if (res.ok) { DATA = await res.json(); render(); }
    } catch(e){ /* növbəti dövrədə */ }
  }

  $('fCompany').addEventListener('change', render);
  poll();
  setInterval(poll, 8000);
</script>
}
