@model GuestsViewModel
@{
    ViewData["Title"] = "Qonaqlar";
    ViewData["Heading"] = "Qonaqlar";
    ViewData["Active"] = "guests";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var canAdd = ViewData["CanAdd"] as bool? ?? false;
    var canEdit = ViewData["CanEdit"] as bool? ?? false;

    string EyeIcon() => "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>";
    string CheckIcon() => "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg>";
    string CardIcon() => "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\"/><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"/></svg>";
    string QrIcon() => "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/><line x1=\"14\" y1=\"14\" x2=\"14\" y2=\"14.01\"/><line x1=\"21\" y1=\"14\" x2=\"21\" y2=\"14.01\"/><line x1=\"14\" y1=\"21\" x2=\"14\" y2=\"21.01\"/><line x1=\"17.5\" y1=\"14\" x2=\"17.5\" y2=\"21\"/><line x1=\"14\" y1=\"17.5\" x2=\"21\" y2=\"17.5\"/></svg>";
}

<div class="page-head">
  <div>
    <p>Qeydiyyatdan keçmiş son ziyarətlər və statuslar.</p>
  </div>
  @if (canAdd)
  {
    <button class="btn btn-primary" id="btnNewGuest">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Yeni qonaq
    </button>
  }
</div>

<section class="panel">
  <div class="panel-head">
    <h3>Qonaq reyestri</h3>
    <div style="display:flex; align-items:center; gap:12px;">
      <div class="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input id="regSearch" type="text" placeholder="Axtarış..." />
      </div>
      <span class="result-count">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
        <span id="resultCount">@Model.Guests.Count nəticə</span>
      </span>
    </div>
  </div>

  <!-- Filtrlər -->
  <div class="filters">
    <div class="select">
      <select id="fStatus">
        <option value="">Bütün statuslar</option>
        <option value="planned">Planlaşdırılmış</option>
        <option value="checkedin">Kart verilib</option>
        <option value="in">Binadadır</option>
        <option value="onfloor">Mərtəbədə</option>
        <option value="out">Çıxıb</option>
        <option value="late">Gecikib</option>
      </select>
    </div>
    <div class="select">
      <select id="fHost">
        <option value="">Bütün qəbul edənlər</option>
        @foreach (var h in Model.Hosts) { <option value="@h.Name">@h.Name</option> }
      </select>
    </div>
    <div class="select">
      <select id="fArea">
        <option value="">Bütün mərtəbələr</option>
        @foreach (var f in Model.Floors) { <option value="@f.Name">@f.Name</option> }
      </select>
    </div>
    <div class="select">
      <select id="fPurpose">
        <option value="">Bütün məqsədlər</option>
        @foreach (var p in Model.Purposes) { <option value="@p.Name">@p.Name</option> }
      </select>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Ad Soyad</th><th>Qəbul edən</th><th>Gəliş vaxtı</th>
          <th>Mərtəbə</th><th>Məqsəd</th><th>Status</th><th>Əməliyyatlar</th>
        </tr>
      </thead>
      <tbody id="registryRows">
        @foreach (var g in Model.Guests)
        {
          var canCheck = g.Status == "in" || g.Status == "onfloor" || g.Status == "checkedin";  // binadadırsa çıxış
          var canCheckIn = g.Status == "planned";   // planlaşdırılmışa kart ver
          <tr data-vid="@g.Id" data-search="@((g.Name + " " + g.Doc).ToLower())"
              data-status="@g.Status" data-host="@g.Host" data-area="@g.Floor" data-purpose="@g.Purpose">
            <td>
              <div class="who-cell">
                @ViewHelpers.Avatar(g.Photo, g.Name)
                <div class="g-name"><b>@g.Name</b><span>@g.Doc</span></div>
              </div>
            </td>
            <td class="cell-sub">@g.Host</td>
            <td class="cell-sub">@g.Arrival</td>
            <td class="cell-sub cell-multi">@g.Floor</td>
            <td class="cell-sub">@g.Purpose</td>
            <td>
              @if (g.PassType == "qr")
              {
                <span class="pass-tag qr" title="QR kod ilə buraxılış">@Html.Raw(QrIcon())</span>
              }
              else
              {
                <span class="pass-tag card" title="Kartla buraxılış">@Html.Raw(CardIcon())</span>
              }
              <span class="js-status">@ViewHelpers.StatusChip(g.Status)</span>
            </td>
            <td>
              <div class="row-actions">
                <button class="act-btn view" title="Buraxılış sənədinə bax" data-id="@g.Id">@Html.Raw(EyeIcon())</button>
                @if (canEdit)
                {
                  <button class="act-btn checkin js-checkin" title="Check-in / Kart ver" type="button"
                          style="@(canCheckIn ? "" : "display:none")"
                          data-id="@g.Id" data-pass="@g.PassType" data-name="@g.Name">@Html.Raw(CardIcon())</button>
                  <form asp-action="Checkout" method="post" class="js-checkout" style="@(canCheck ? "display:inline" : "display:none")"
                        onsubmit="return confirm('@g.Name üçün çıxışı təsdiqləyirsiniz?');">
                    <input type="hidden" name="id" value="@g.Id" />
                    <button class="act-btn check" title="Çıxışı təsdiqlə" type="submit">@Html.Raw(CheckIcon())</button>
                  </form>
                }
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</section>

<!-- ============ YENİ QONAQ MODALI ============ -->
<div class="modal-overlay" id="guestModal">
  <form class="modal" asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="modal-head">
      <h2>Yeni qonaq qeydiyyatı</h2>
      <button class="modal-close" id="modalClose" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="modal-body">
      <!-- Sütun 1: Şəxsi məlumatlar -->
      <div class="form-col">
        <div class="col-title">Şəxsi məlumatlar</div>
        <div class="field"><label>Ad <span class="req">*</span></label><input name="FirstName" type="text" placeholder="Orxan" required /></div>
        <div class="field"><label>Soyad <span class="req">*</span></label><input name="LastName" type="text" placeholder="Məmmədov" required /></div>
        <div class="field"><label>Atasının adı</label><input name="Patronymic" type="text" placeholder="Faiq" /></div>
        <div class="field"><label>Şəxsiyyət vəsiqəsi <span class="req">*</span></label><input name="IdDocument" type="text" placeholder="AZE12345678" required /></div>
        <div class="field"><label>Telefon</label><input name="Phone" type="text" placeholder="+994 50 123 45 67" /></div>
        <div class="field"><label>Email</label><input name="Email" type="email" placeholder="orxan@@example.com" /></div>
      </div>

      <!-- Sütun 2: Giriş məlumatları -->
      <div class="form-col">
        <div class="col-title">Giriş məlumatları</div>
        <div class="field">
          <label>Qəbul edən şəxs <span class="req">*</span></label>
          <select name="HostId" required>
            @foreach (var h in Model.Hosts) { <option value="@h.Id">@h.Name</option> }
          </select>
        </div>
        <div class="field-row">
          <div class="field"><label>Gəliş tarixi <span class="req">*</span></label><input id="inArrivalDate" name="ArrivalDate" type="date" value="@today" min="@today" required /></div>
          <div class="field"><label>Vaxt <span class="req">*</span></label><input class="time24" name="ArrivalTime" type="text" value="09:00" required pattern="([01][0-9]|2[0-3]):[0-5][0-9]" placeholder="SS:DD" maxlength="5" inputmode="numeric" title="24 saatlıq format, məsələn 14:30" /></div>
        </div>
        <div class="field">
          <label>Məqsədlər <span class="req">*</span></label>
          <select name="PurposeId" required>
            @foreach (var p in Model.Purposes) { <option value="@p.Id">@p.Name</option> }
          </select>
        </div>
        <div class="field">
          <label>İcazə verilən mərtəbə <span class="req">*</span></label>
          <select name="FloorId" required>
            @foreach (var f in Model.Floors) { <option value="@f.Id">@f.Name</option> }
          </select>
        </div>
        <div class="field">
          <label>Buraxılış növü <span class="req">*</span></label>
          <input type="hidden" name="PassType" id="passTypeInput" value="card" />
          <div class="pass-choice">
            <button type="button" class="seg-btn active" data-pass="card">
              @Html.Raw(CardIcon()) Kartla
            </button>
            <button type="button" class="seg-btn" data-pass="qr">
              @Html.Raw(QrIcon()) QR kod ilə
            </button>
          </div>
        </div>
        <div class="field qr-note" id="qrNoteField" style="display:none;">
          <div class="qr-info-box">
            @Html.Raw(QrIcon())
            QR kod qonaq məlumatlarından avtomatik generasiya olunacaq və çap edilə biləcək.
          </div>
        </div>
        <div class="field">
          <div class="qr-info-box" style="background:rgba(99,102,241,.08);color:#4f46e5">
            @Html.Raw(CardIcon())
            Kartla buraxılışda kart gəlişdə (check-in zamanı) nəzarətçi tərəfindən təyin olunur.
          </div>
        </div>
        <div class="field-row">
          <div class="field"><label>Çıxış tarixi</label><input id="inExitDate" name="ExitDate" type="date" value="@today" min="@today" /></div>
          <div class="field"><label>Vaxt</label><input class="time24" name="ExitTime" type="text" value="17:00" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" placeholder="SS:DD" maxlength="5" inputmode="numeric" title="24 saatlıq format, məsələn 17:00" /></div>
        </div>
        <div class="field"><label>Qeyd</label><textarea name="Note" placeholder="Əlavə qeyd..."></textarea></div>
      </div>

      <!-- Sütun 3: Şəkil + Sənəd -->
      <div class="form-col">
        <div class="col-title">Şəkil</div>
        <div class="upload-box" id="photoBox">
          <div class="up-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg></div>
          <b id="photoBoxLabel">Şəkil seçin</b>
          <small>Klikləyərək fayl yükləyin</small>
          <img id="photoPreview" alt="Önizləmə" style="display:none;max-width:100%;margin-top:12px;border-radius:10px;" />
        </div>
        <input id="inPhotoFile" name="Photo" type="file" accept="image/*" hidden />

        <div class="doc-box">
          <div class="col-title" style="margin-top:24px;">Sənəd</div>
          <div class="doc-status" id="docStatus">Sənəd seçilməyib</div>
          <input id="inDocFile" name="Document" type="file" accept="image/*,application/pdf" hidden />
          <button class="btn-file" type="button" id="btnDocFile">Fayl seç</button>
        </div>
      </div>
    </div>

    <div class="modal-foot">
      <button class="btn btn-ghost" id="modalCancel" type="button">Ləğv et</button>
      <button class="btn btn-primary" type="submit">Qeydiyyatı tamamla</button>
    </div>
  </form>
</div>

<!-- ============ CHECK-IN MODALI ============ -->
<div class="modal-overlay" id="checkinModal">
  <form class="modal" asp-action="CheckIn" method="post" style="max-width:460px">
    <div class="modal-head">
      <h2>Check-in — Kart ver</h2>
      <button class="modal-close" id="checkinClose" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="modal-body" style="display:block">
      <input type="hidden" name="id" id="checkinVisitId" />
      <p class="hint" id="checkinName" style="margin:0 0 16px"></p>
      <div class="field" id="checkinCardField">
        <label>Müvəqqəti kart <span class="req">*</span></label>
        <select name="cardId" id="checkinCard">
          @foreach (var c in Model.FreeCards) { <option value="@c.Id">@c.Name</option> }
        </select>
        <small class="hint">Seçilən kart cihazlara yazılacaq və qonağa veriləcək.</small>
      </div>
      <div class="field" id="checkinQrNote" style="display:none">
        <div class="qr-info-box">@Html.Raw(QrIcon()) QR növü — fiziki kart lazım deyil. Nömrə cihazlara yazılacaq.</div>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-ghost" id="checkinCancel" type="button">Ləğv et</button>
      <button class="btn btn-primary" type="submit">Check-in et</button>
    </div>
  </form>
</div>

@section Scripts {
  <script>
    var GUESTS_DATA = @Html.Raw(Json.Serialize(Model.Guests));
  </script>
  <script src="~/js/guests-mvc.js"></script>
}
