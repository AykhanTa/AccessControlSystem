@{
    var active = ViewData["Active"] as string ?? "";
    string Nav(string key) => active == key ? "nav-item active" : "nav-item";

    var allowed = ViewData["AllowedSections"] as HashSet<string> ?? new HashSet<string>();
    var isGlobalAdmin = ViewData["IsGlobalAdmin"] as bool? ?? false;
    bool CanSee(string code) => isGlobalAdmin || code == "dashboard" || allowed.Contains(code);

    var displayName = User.Identity?.Name ?? "İstifadəçi";
    var roleName = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var initials = string.Concat(displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(w => char.ToUpper(w[0])));
}
<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] — Giriş-çıxışa Nəzarət Sistemi</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/style.css" />
<link rel="stylesheet" href="~/css/modal.css" />
<style>
  .app-alert{padding:12px 16px;border-radius:10px;font-size:14px;font-weight:600;margin-bottom:16px}
  .app-alert.success{background:#dcfce7;color:#166534;border:1px solid #bbf7d0}
  .app-alert.error{background:#fee2e2;color:#991b1b;border:1px solid #fecaca}
  /* İcazə matrisi — Açıq/Bağlı pill (checkbox) */
  .perm-toggle{position:absolute;opacity:0;width:0;height:0}
  .perm-toggle + label{display:inline-block;min-width:62px;text-align:center;padding:5px 10px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;background:#fee2e2;color:#991b1b;border:1px solid #fecaca;user-select:none}
  .perm-toggle + label::after{content:'Bağlı'}
  .perm-toggle:checked + label{background:#dcfce7;color:#166534;border-color:#bbf7d0}
  .perm-toggle:checked + label::after{content:'Açıq'}
  .perm-toggle:disabled + label{opacity:.65;cursor:not-allowed}
  .perm-toggle:focus-visible + label{outline:2px solid #6366f1;outline-offset:2px}
  /* Loq əməliyyat kodu */
  .log-action{font-family:ui-monospace,'Cascadia Code',Consolas,monospace;font-size:12px;font-weight:700;letter-spacing:.02em;color:#334155}
  /* Səhifələmə (pager) */
  .pager{display:flex;flex-wrap:wrap;gap:6px;align-items:center;justify-content:center;padding:16px;border-top:1px solid var(--border)}
  .pager a,.pager span{min-width:36px;height:36px;padding:0 10px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--border);border-radius:9px;font-size:13px;font-weight:600;color:var(--text);text-decoration:none;background:#fff}
  .pager a:hover{background:var(--bg)}
  .pager a.active{background:var(--primary);color:#fff;border-color:var(--primary)}
  .pager a.disabled{opacity:.45;pointer-events:none}
  .pager span.gap{border:none;background:transparent;min-width:auto}
  /* Çap: yalnız kontent çap olunsun */
  @@media print {
    .sidebar, .topbar, .backdrop, .no-print { display: none !important; }
    .app { display: block !important; }
    .main { margin: 0 !important; }
    .content { padding: 0 !important; }
    .panel { box-shadow: none !important; border: none !important; }
  }
</style>
</head>
<body>
<div class="app">

  <!-- ============ SIDEBAR ============ -->
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <h1>Giriş-çıxışa Nəzarət<br>Sistemi</h1>
    </div>
    <nav class="nav">
      <a href="/" class="@Nav("dashboard")">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg> Ana səhifə
      </a>
      @if (CanSee("guests"))
      {
        <a href="/Guests" class="@Nav("guests")">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg> Qonaqlar
        </a>
      }
      @if (CanSee("cards"))
      {
        <a href="/Cards" class="@Nav("cards")">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg> Kartlar
        </a>
      }
      @if (CanSee("history"))
      {
        <a href="/History" class="@Nav("history")">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg> Giriş-çıxış tarixçəsi
        </a>
      }
      @if (CanSee("active_permits"))
      {
        <a href="/ActivePermits" class="@Nav("active_permits")">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg> Aktiv icazələr
        </a>
      }
      @if (CanSee("reports"))
      {
        <a href="/Reports" class="@Nav("reports")">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="8"/><rect x="12" y="6" width="3" height="12"/><rect x="17" y="13" width="3" height="5"/></svg> Hesabatlar
        </a>
      }
      @if (CanSee("logs"))
      {
        <a href="/Logs" class="@Nav("logs")">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/></svg> Sistem Loqları
        </a>
      }
      @if (CanSee("users"))
      {
        <a href="/Users" class="@Nav("users")">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg> İstifadəçilər
        </a>
      }
      @if (CanSee("roles"))
      {
        <a href="/Roles" class="@Nav("roles")">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Rollar
        </a>
      }
      @if (CanSee("settings"))
      {
        <a href="/Settings" class="@Nav("settings")">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg> Parametrlər
        </a>
      }
    </nav>
  </aside>
  <div class="backdrop" id="backdrop" onclick="closeSidebar()"></div>

  <!-- ============ MAIN ============ -->
  <div class="main">
    <header class="topbar">
      <button class="menu-btn" onclick="openSidebar()">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
      </button>
      <h2>@ViewData["Heading"]</h2>
      <div class="spacer"></div>
      <button class="icon-btn" title="Bildirişlər">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      </button>
      <div class="divider"></div>
      <div class="profile">
        <div class="avatar">@initials</div>
        <div class="who"><b>@displayName</b><span>@roleName</span></div>
      </div>
      <form asp-controller="Account" asp-action="Logout" method="post" style="margin-left:6px;display:inline">
        <button class="icon-btn" type="submit" title="Çıxış et">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </button>
      </form>
    </header>

    <main class="content">
      @if (TempData["Success"] is string ok)
      {
        <div class="app-alert success">@ok</div>
      }
      @if (TempData["Error"] is string err)
      {
        <div class="app-alert error">@err</div>
      }
      @RenderBody()
    </main>
  </div>
</div>

<script src="~/js/qrcode.min.js"></script>
<script src="~/js/common-mvc.js"></script>
<script src="~/js/panel.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
