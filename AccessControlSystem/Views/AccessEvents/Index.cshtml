@using AccessControlSystem.Domain.Entities
@{
    ViewData["Title"] = "Keçid hadisələri";
    ViewData["Heading"] = "Keçid hadisələri";
    ViewData["Active"] = "access_events";
    var devices = ViewBag.Devices as List<Device> ?? new List<Device>();
    var defStart = ViewBag.DefaultStart as string ?? "";
    var defEnd = ViewBag.DefaultEnd as string ?? "";
}

<style>
  .ev-thumb{width:44px;height:44px;object-fit:cover;border-radius:8px;cursor:pointer;
            border:1px solid var(--border,#e5e7eb);background:#f3f4f6;display:block}
  .ev-thumb:hover{outline:2px solid var(--primary,#2563eb)}
  #imgLightbox{position:fixed;inset:0;background:rgba(0,0,0,.8);display:none;
               align-items:center;justify-content:center;z-index:9999;cursor:zoom-out}
  #imgLightbox img{max-width:90vw;max-height:90vh;border-radius:10px;box-shadow:0 10px 40px rgba(0,0,0,.5)}
</style>

<div class="page-head">
  <div><p>Hikvision cihazının öz jurnalı — bütün hadisə tipləri (qapı, üz, login). Giriş/çıxış anında çəkilən şəkillərlə. Tarix + saat aralığı ilə axtarış.</p></div>
</div>

<div id="imgLightbox" onclick="closeImg()"><img id="imgLightboxSrc" src="" alt="" /></div>

<div style="display:grid;grid-template-columns:260px 1fr;gap:16px;align-items:start">

  <!-- Filtr paneli -->
  <section class="panel" style="padding:16px">
    <div class="field">
      <label>Cihaz</label>
      <select id="fDevice" class="input">
        <option value="0">Bütün cihazlar</option>
        @for (var idx = 0; idx < devices.Count; idx++)
        {
          <option value="@devices[idx].Id" selected="@(idx == 0)">@devices[idx].Name (@devices[idx].Ip)</option>
        }
      </select>
    </div>
    <div class="field">
      <label>Başlanğıc vaxt</label>
      <input type="datetime-local" id="fStart" step="1" lang="en-GB" class="input" value="@defStart" />
    </div>
    <div class="field">
      <label>Son vaxt</label>
      <input type="datetime-local" id="fEnd" step="1" lang="en-GB" class="input" value="@defEnd" />
    </div>
    <div class="field">
      <label>İşçi İD</label>
      <input type="text" id="fEmp" class="input" placeholder="məs. 26" value="@(ViewBag.EmpId as string ?? "")" />
    </div>
    <div class="field">
      <label>Ad</label>
      <input type="text" id="fName" class="input" />
    </div>
    <div class="field">
      <label>Kart nömrəsi</label>
      <input type="text" id="fCard" class="input" />
    </div>
    <div style="display:flex;gap:8px;margin-top:6px">
      <button class="btn btn-primary" type="button" id="btnSearch" style="flex:1">Axtar</button>
      <button class="btn" type="button" id="btnToday">Bu gün</button>
    </div>
    <label style="display:flex;align-items:center;gap:8px;margin-top:14px;font-size:13px;cursor:pointer">
      <input type="checkbox" id="fLive" /> Canlı yenilə (5 san)
    </label>
    @if (!devices.Any())
    {
      <p class="hint" style="margin-top:12px;color:var(--muted)">Aktiv cihaz yoxdur — Parametrlər bölməsindən cihaz əlavə edin.</p>
    }
  </section>

  <!-- Nəticələr -->
  <section class="panel">
    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--border, #eee);flex-wrap:wrap;gap:10px">
      <span class="hint" id="evInfo" style="color:var(--muted)">Axtarış üçün "Axtar" düyməsinə basın.</span>
      <div style="display:flex;align-items:center;gap:8px">
        <label style="font-size:13px;color:var(--muted)">Səhifədə</label>
        <select id="fPageSize" class="input" style="width:auto">
          <option>24</option><option>48</option><option>100</option>
        </select>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>No.</th><th>Şəkil</th><th>İşçi İD</th><th>Ad</th><th>Kart №</th><th>Hadisə tipi</th><th>Vaxt</th>
          </tr>
        </thead>
        <tbody id="evRows"></tbody>
      </table>
    </div>
    <div id="evEmpty" class="empty-state" style="display:none;padding:32px;text-align:center;color:var(--muted)">
      Bu aralıqda hadisə tapılmadı.
    </div>
    <div id="evPager" style="display:none;justify-content:space-between;align-items:center;padding:12px 16px;border-top:1px solid var(--border,#eee);flex-wrap:wrap;gap:10px">
      <span class="hint" id="evTotal" style="color:var(--muted)"></span>
      <div style="display:flex;align-items:center;gap:6px">
        <button class="btn" type="button" id="btnPrev">‹</button>
        <span id="evPageLbl" style="font-size:13px;min-width:90px;text-align:center"></span>
        <button class="btn" type="button" id="btnNext">›</button>
      </div>
    </div>
  </section>
</div>

@section Scripts {
<script>
  let page = 1, totalPages = 0, busy = false, liveTimer = null;

  const $ = id => document.getElementById(id);
  function esc(s){ return (s ?? '').toString().replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

  window.openImg = function(src){ $('imgLightboxSrc').src = src; $('imgLightbox').style.display = 'flex'; };
  window.closeImg = function(){ $('imgLightbox').style.display = 'none'; $('imgLightboxSrc').src = ''; };
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeImg(); });

  function eventChip(t){
    const cls = /uğursuz|failed|sabotaj|xəbərdarlıq/i.test(t) ? 'late'
              : /təsdiqləndi|açıldı/i.test(t) ? 'in'
              : /bağlandı/i.test(t) ? 'out' : 'checkedin';
    return `<span class="chip ${cls}">${esc(t)}</span>`;
  }

  function render(d){
    const tb = $('evRows');
    if (d.error){
      tb.innerHTML = '';
      $('evEmpty').style.display = 'none';
      $('evPager').style.display = 'none';
      $('evInfo').textContent = '⚠ ' + d.error;
      return;
    }
    const rows = d.items || [];
    $('evEmpty').style.display = rows.length ? 'none' : 'block';
    tb.innerHTML = rows.map(r => `
      <tr>
        <td class="cell-sub">${r.no}</td>
        <td>${r.photoUrl
              ? `<img src="${esc(r.photoUrl)}" class="ev-thumb" loading="lazy" onclick="openImg(this.src)" onerror="this.remove()" alt="şəkil" />`
              : '<span class="cell-sub">—</span>'}</td>
        <td class="cell-sub"><b>${esc(r.employeeId)}</b></td>
        <td>${esc(r.name)}</td>
        <td class="cell-sub">${esc(r.cardNo)}</td>
        <td>${eventChip(r.eventType)}</td>
        <td class="cell-sub" style="white-space:nowrap">${esc(r.time)}</td>
      </tr>`).join('');

    page = d.page; totalPages = d.totalPages;
    $('evInfo').textContent = d.total ? `Cəmi ${d.total} hadisə` : `${rows.length} hadisə`;
    $('evTotal').textContent = `Cəmi: ${d.total}`;
    $('evPageLbl').textContent = totalPages ? `${page} / ${totalPages}` : `Səhifə ${page}`;
    $('btnPrev').disabled = page <= 1;
    $('btnNext').disabled = totalPages ? page >= totalPages : rows.length < d.pageSize;
    $('evPager').style.display = rows.length || page > 1 ? 'flex' : 'none';
  }

  async function search(){
    if (busy) return;
    busy = true;
    $('evInfo').textContent = 'Yüklənir…';
    const qs = new URLSearchParams({
      deviceId: $('fDevice').value || '0',
      start: $('fStart').value,
      end: $('fEnd').value,
      page: page,
      pageSize: $('fPageSize').value,
      empId: $('fEmp').value.trim(),
      name: $('fName').value.trim(),
      card: $('fCard').value.trim()
    });
    try {
      const res = await fetch('/AccessEvents/Search?' + qs.toString(),
                              { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      render(res.ok ? await res.json() : { error: 'Server xətası (' + res.status + ')' });
    } catch(e){ render({ error: 'Şəbəkə xətası' }); }
    finally { busy = false; }
  }

  function newSearch(){ page = 1; search(); }

  $('btnSearch').addEventListener('click', newSearch);
  $('fPageSize').addEventListener('change', newSearch);
  $('btnPrev').addEventListener('click', () => { if (page > 1){ page--; search(); } });
  $('btnNext').addEventListener('click', () => { if (!totalPages || page < totalPages){ page++; search(); } });
  ['fEmp','fName','fCard'].forEach(id => $(id).addEventListener('keydown', e => { if (e.key === 'Enter') newSearch(); }));

  $('btnToday').addEventListener('click', () => {
    const d = new Date(); d.setHours(0,0,0,0);
    const e = new Date(); e.setHours(23,59,59,0);
    const fmt = x => x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0')+'-'+String(x.getDate()).padStart(2,'0')
                     +'T'+String(x.getHours()).padStart(2,'0')+':'+String(x.getMinutes()).padStart(2,'0')+':'+String(x.getSeconds()).padStart(2,'0');
    $('fStart').value = fmt(d); $('fEnd').value = fmt(e);
    newSearch();
  });

  $('fLive').addEventListener('change', e => {
    if (e.target.checked){ liveTimer = setInterval(() => { if (page === 1) search(); }, 5000); }
    else { clearInterval(liveTimer); liveTimer = null; }
  });

  // İlk yükləmədə avtomatik axtar (default: bugün).
  @if (devices.Any()) { <text>newSearch();</text> }
</script>
}
