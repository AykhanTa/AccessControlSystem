@using AccessControlSystem.Application.DTOs
@model LeaveViewModel
@*  Parametrlər → "Məzuniyyət & Bayram" tabı.
    Əməliyyatlar LeaveController-dədir və "employees" icazəsi ilə işləyir — buna görə
    düymələr ViewData["EmpCan*"] (settings deyil, employees bölməsinin icazələri) ilə göstərilir.  *@
@{
    var isGlobalAdmin = ViewData["IsGlobalAdmin"] as bool? ?? false;

    var access = ViewData["Access"] as Dictionary<string, SectionAccessDto> ?? new();
    var acc = access.TryGetValue("employees", out var empA) ? empA : new SectionAccessDto();
    var canAdd = acc.CanAdd;
    var canEdit = acc.CanEdit;
    var canDelete = acc.CanDelete;
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="page-head">
  <div><p>HR: işçilərin məzuniyyət/ezamiyyət qeydləri və bayram təqvimi. Bunlar iştirak hesabatında avtomatik nəzərə alınır.</p></div>
  <form method="get" asp-controller="Settings" asp-action="Index" style="display:flex;gap:8px;align-items:center">
    <input type="hidden" name="tab" value="leave" />
    <label style="font-size:13px;color:var(--muted)">İl:</label>
    <select name="year" class="lv-input" onchange="this.form.submit()">
      @for (int yy = DateTime.Today.Year - 1; yy <= DateTime.Today.Year + 1; yy++)
      { <option value="@yy" selected="@(yy == Model.Year)">@yy</option> }
    </select>
  </form>
</div>

<div class="param-grid">
  <!-- ================= Növlər ================= -->
  <section class="panel">
    <div class="param-head"><h3>Məzuniyyət / Ezamiyyət növləri</h3></div>
    @if (canAdd)
    {
      <form asp-controller="Leave" asp-action="AddType" method="post" class="lv-form">
        <div class="lv-fld grow"><label>Ad</label><input name="name" type="text" placeholder="İllik məzuniyyət" required /></div>
        <div class="lv-fld sm"><label>Rəng</label><input name="color" type="color" value="#8b5cf6" /></div>
        <div class="lv-fld chk"><label><input type="checkbox" name="countsAsWorked" value="true" /> İşdə sayılır (ezamiyyət)</label></div>
        @if (isGlobalAdmin)
        {
          <div class="lv-fld"><label>Şirkət</label>
            <select name="companyId"><option value="">Qlobal</option>
              @foreach (var c in Model.Companies) { <option value="@c.Id">@c.Name</option> }
            </select>
          </div>
        }
        <div class="lv-fld end"><button class="btn btn-primary" type="submit">Əlavə et</button></div>
      </form>
    }
    <div>
      @foreach (var t in Model.Types)
      {
        <div class="param-item">
          <div class="param-item-info">
            <b><span class="lv-dot" style="background:@t.Color"></span>@t.Name</b>
            <span>@t.CompanyName · @(t.CountsAsWorked ? "İşdə sayılır" : "Üzrlü") · @t.UsageCount qeyd · <span class="@(t.IsActive ? "st-on" : "st-off")">@(t.IsActive ? "Aktiv" : "Deaktiv")</span></span>
          </div>
          <div class="host-actions">
            @if (canEdit)
            {
              <form asp-controller="Leave" asp-action="ToggleType" method="post" style="display:inline"><input type="hidden" name="id" value="@t.Id" />
                <button class="btn-sm outline" type="submit">@(t.IsActive ? "Deaktiv et" : "Aktiv et")</button></form>
            }
            @if (canDelete)
            {
              <form asp-controller="Leave" asp-action="DeleteType" method="post" style="display:inline" onsubmit="return confirm('&quot;@t.Name&quot; silinsin?');">
                <input type="hidden" name="id" value="@t.Id" /><button class="btn-sm danger" type="submit">Sil</button></form>
            }
          </div>
        </div>
      }
      @if (Model.Types.Count == 0) { <p class="hint" style="padding:14px 22px">Növ yoxdur.</p> }
    </div>
  </section>

  <!-- ================= Bayram təqvimi ================= -->
  <section class="panel">
    <div class="param-head"><h3>Bayram təqvimi (@Model.Year)</h3></div>
    @if (canAdd)
    {
      <form asp-controller="Leave" asp-action="AddHoliday" method="post" class="lv-form">
        <div class="lv-fld sm"><label>Başlanğıc</label><input name="startDate" type="date" value="@today" required /></div>
        <div class="lv-fld sm"><label>Son</label><input name="endDate" type="date" value="@today" required /></div>
        <div class="lv-fld grow"><label>Ad</label><input name="name" type="text" placeholder="Novruz bayramı" required /></div>
        @if (isGlobalAdmin)
        {
          <div class="lv-fld"><label>Şirkət</label>
            <select name="companyId"><option value="">Qlobal</option>
              @foreach (var c in Model.Companies) { <option value="@c.Id">@c.Name</option> }
            </select>
          </div>
        }
        <div class="lv-fld end"><button class="btn btn-primary" type="submit">Əlavə et</button></div>
      </form>
    }
    <div>
      @foreach (var h in Model.Holidays)
      {
        <div class="param-item">
          <div class="param-item-info">
            <b>@h.RangeLabel @if (h.Days > 1) { <span style="color:var(--faint);font-weight:500">(@h.Days gün)</span> } – @h.Name</b>
            <span>@h.CompanyName</span>
          </div>
          <div class="host-actions">
            @if (canDelete)
            {
              <form asp-controller="Leave" asp-action="DeleteHoliday" method="post" style="display:inline" onsubmit="return confirm('Bayram silinsin?');">
                <input type="hidden" name="ids" value="@h.Ids" /><button class="btn-sm danger" type="submit">Sil</button></form>
            }
          </div>
        </div>
      }
      @if (Model.Holidays.Count == 0) { <p class="hint" style="padding:14px 22px">Bu il üçün bayram əlavə edilməyib.</p> }
    </div>
  </section>
</div>

<!-- ================= İşçi qeydləri (aşağıda — siyahı böyüyür) ================= -->
<section class="panel" style="margin-top:16px">
  <div class="param-head"><h3>İşçi qeydləri (@Model.Year)</h3></div>
  @if (canAdd)
  {
    <form asp-controller="Leave" asp-action="AddRecord" method="post" class="lv-form">
      <div class="lv-fld grow"><label>İşçi</label>
        <select name="employeeId" required>
          <option value="">Seçin</option>
          @foreach (var e in Model.Employees) { <option value="@e.Id">@e.Name (@e.EmployeeNo)</option> }
        </select>
      </div>
      <div class="lv-fld"><label>Növ</label>
        <select name="leaveTypeId" required>
          <option value="">Seçin</option>
          @foreach (var t in Model.TypeLookup) { <option value="@t.Id">@t.Name</option> }
        </select>
      </div>
      <div class="lv-fld sm"><label>Başlanğıc</label><input name="startDate" type="date" value="@today" required /></div>
      <div class="lv-fld sm"><label>Son</label><input name="endDate" type="date" value="@today" required /></div>
      <div class="lv-fld grow"><label>Qeyd (istəyə görə)</label><input name="reason" type="text" placeholder="Qeyd" /></div>
      <div class="lv-fld end"><button class="btn btn-primary" type="submit">Əlavə et</button></div>
    </form>
  }
  <div class="table-wrap" style="overflow-x:auto">
    <table class="lv-table">
      <thead><tr><th>İşçi</th><th>Şöbə</th><th>Növ</th><th>Aralıq</th><th>Gün</th><th>Qeyd</th><th></th></tr></thead>
      <tbody id="lvRows">
        @foreach (var r in Model.Records)
        {
          <tr data-rec>
            <td><b>@r.EmployeeName</b> <span style="color:var(--faint)">@r.EmployeeNo</span></td>
            <td>@(r.Department ?? "—")</td>
            <td><span class="lv-badge" style="background:@r.Color">@r.TypeName@(r.CountsAsWorked ? " · işdə" : "")</span></td>
            <td>@r.StartDate – @r.EndDate</td>
            <td>@r.Days</td>
            <td>@(string.IsNullOrEmpty(r.Reason) ? "—" : r.Reason)</td>
            <td style="text-align:right">
              @if (canDelete)
              {
                <form asp-controller="Leave" asp-action="DeleteRecord" method="post" style="display:inline" onsubmit="return confirm('Qeyd silinsin?');">
                  <input type="hidden" name="id" value="@r.Id" />
                  <button class="btn-sm danger" type="submit">Sil</button>
                </form>
              }
            </td>
          </tr>
        }
        @if (Model.Records.Count == 0) { <tr><td colspan="7" style="text-align:center;color:var(--muted);padding:20px">Bu il üçün qeyd yoxdur.</td></tr> }
      </tbody>
    </table>
  </div>
  <div id="lvPager" class="lv-pager"></div>
</section>

<style>
  .lv-form{display:flex;gap:12px;align-items:end;flex-wrap:wrap;padding:6px 22px 16px}
  .lv-fld{display:flex;flex-direction:column;gap:5px;min-width:0}
  .lv-fld.grow{flex:1 1 180px}
  .lv-fld.sm{width:150px}
  .lv-fld.end{justify-content:flex-end}
  .lv-fld.chk{justify-content:center}
  .lv-fld label{font-size:12.5px;font-weight:600;color:var(--ink,#3a4152)}
  .lv-fld.chk label{flex-direction:row;display:inline-flex;align-items:center;gap:6px;font-weight:500;cursor:pointer}
  .lv-fld input,.lv-fld select,.lv-input{height:40px;padding:0 12px;border:1px solid var(--border,#dde1e8);border-radius:10px;background:#fff;font-size:14px;box-sizing:border-box}
  .lv-fld input[type=color]{padding:3px;cursor:pointer}
  .lv-fld input[type=checkbox]{height:auto;width:auto}
  .lv-table{width:100%;border-collapse:collapse;font-size:13.5px}
  .lv-table th,.lv-table td{padding:9px 22px;border-bottom:1px solid var(--line,#eef0f4);text-align:left;white-space:nowrap}
  .lv-table th{font-size:12px;text-transform:uppercase;letter-spacing:.03em;color:var(--faint,#9095a1);font-weight:700}
  .lv-badge{display:inline-block;padding:2px 9px;border-radius:20px;font-size:12px;font-weight:600;color:#fff}
  .lv-dot{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:middle}
  .lv-pager{display:flex;gap:8px;align-items:center;justify-content:flex-end;flex-wrap:wrap;padding:12px 22px}
  .lv-pager .muted{color:var(--muted);font-size:13px;margin-right:auto}
  .lv-pager .btn{height:34px;min-width:38px;padding:0 12px;font-size:15px}
</style>
<script>
  (function () {
    var rows = Array.prototype.slice.call(document.querySelectorAll('#lvRows tr[data-rec]'));
    var host = document.getElementById('lvPager');
    var size = 15, page = 1;
    function draw() {
      var total = rows.length;
      var pages = Math.max(1, Math.ceil(total / size));
      if (page > pages) page = pages;
      var start = (page - 1) * size, end = start + size;
      for (var i = 0; i < total; i++) rows[i].style.display = (i >= start && i < end) ? '' : 'none';
      if (total <= size) { host.innerHTML = ''; return; }
      host.innerHTML =
        '<span class="muted">Cəmi ' + total + ' qeyd · Səhifə ' + page + '/' + pages + '</span>'
        + '<button class="btn btn-ghost" type="button" ' + (page <= 1 ? 'disabled' : '') + ' id="lvPrev">‹ Əvvəlki</button>'
        + '<button class="btn btn-ghost" type="button" ' + (page >= pages ? 'disabled' : '') + ' id="lvNext">Sonrakı ›</button>';
      var p = document.getElementById('lvPrev'), n = document.getElementById('lvNext');
      if (p) p.onclick = function () { page--; draw(); };
      if (n) n.onclick = function () { page++; draw(); };
    }
    draw();
  })();
</script>
