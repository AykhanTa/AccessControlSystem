@model SettingsViewModel
@{
    ViewData["Title"] = "Parametrlər";
    ViewData["Heading"] = "Parametrlər";
    ViewData["Active"] = "settings";
    var canAdd = ViewData["CanAdd"] as bool? ?? false;
    var canEdit = ViewData["CanEdit"] as bool? ?? false;
    var canDelete = ViewData["CanDelete"] as bool? ?? false;
    var isGlobalAdmin = ViewData["IsGlobalAdmin"] as bool? ?? false;   // Mərkəz/Şirkət yalnız qlobal admin
}

<div class="page-head">
  <div>
    <p>Mərkəzlər, mərtəbələr, cihazlar, qəbul edən şəxslər və məqsədlər bazadan idarə olunur.</p>
  </div>
</div>

<!-- Mərkəzlər (binalar) -->
<section class="panel">
  <div class="param-head"><h3>Mərkəzlər (binalar)</h3></div>
  @if (canAdd && isGlobalAdmin)
  {
    <form asp-action="AddCenter" method="post" class="device-form device-add">
      <div class="fld sm"><label>Kod</label><input name="code" type="text" placeholder="HQ" required /></div>
      <div class="fld grow"><label>Ad</label><input name="name" type="text" placeholder="Baş Ofis" required /></div>
      <div class="fld"><label>Şəhər</label><input name="city" type="text" placeholder="Bakı" /></div>
      <div class="fld"><label>Şirkət</label>
        <select name="companyId" required>
          <option value="">Seçin</option>
          @foreach (var co in Model.Companies) { <option value="@co.Id">@co.Name</option> }
        </select>
      </div>
      <div class="fld end"><button class="btn btn-primary" type="submit">Əlavə et</button></div>
    </form>
  }
  <div>
    @foreach (var c in Model.Centers)
    {
      <div class="param-item">
        <div class="param-item-info">
          <b>@c.Name <span style="color:var(--faint);font-weight:500">(@c.Code)</span></b>
          <span>@(string.IsNullOrEmpty(c.City) ? "—" : c.City) · @c.FloorCount mərtəbə · <span class="@(c.IsActive ? "st-on" : "st-off")">@(c.IsActive ? "Aktiv" : "Deaktiv")</span></span>
        </div>
        <div class="host-actions">
          @if (canEdit && isGlobalAdmin)
          {
            <form asp-action="ToggleCenter" method="post" style="display:inline">
              <input type="hidden" name="id" value="@c.Id" />
              <button class="btn-sm outline" type="submit">@(c.IsActive ? "Deaktiv et" : "Aktiv et")</button>
            </form>
          }
          @if (canDelete && isGlobalAdmin)
          {
            <form asp-action="DeleteCenter" method="post" style="display:inline"
                  onsubmit="return confirm('&quot;@c.Name&quot; mərkəzi silinsin?');">
              <input type="hidden" name="id" value="@c.Id" />
              <button class="btn-sm danger" type="submit">Sil</button>
            </form>
          }
        </div>
      </div>
    }
    @if (Model.Centers.Count == 0)
    {
      <p class="hint" style="padding:14px 22px">Hələ mərkəz əlavə edilməyib.</p>
    }
  </div>
</section>

<!-- Şirkətlər (yalnız qlobal admin idarə edir) -->
@if (isGlobalAdmin)
{
<section class="panel">
  <div class="param-head"><h3>Şirkətlər</h3></div>
  @if (canAdd)
  {
    <form asp-action="AddCompany" method="post" class="device-form device-add">
      <div class="fld grow"><label>Ad</label><input name="name" type="text" placeholder="Şirkət adı" required /></div>
      <div class="fld"><label>Əlaqədar şəxs</label><input name="contactPerson" type="text" /></div>
      <div class="fld"><label>Telefon</label><input name="phone" type="text" /></div>
      <div class="fld end"><button class="btn btn-primary" type="submit">Əlavə et</button></div>
    </form>
  }
  <div>
    @foreach (var c in Model.Companies)
    {
      <div class="param-item">
        <div class="param-item-info">
          <b>@c.Name</b>
          <span>@c.DepartmentCount şöbə · <span class="@(c.IsActive ? "st-on" : "st-off")">@(c.IsActive ? "Aktiv" : "Deaktiv")</span></span>
        </div>
        <div class="host-actions">
          @if (canEdit)
          {
            <form asp-action="ToggleCompany" method="post" style="display:inline">
              <input type="hidden" name="id" value="@c.Id" />
              <button class="btn-sm outline" type="submit">@(c.IsActive ? "Deaktiv et" : "Aktiv et")</button>
            </form>
          }
          @if (canDelete)
          {
            <form asp-action="DeleteCompany" method="post" style="display:inline"
                  onsubmit="return confirm('&quot;@c.Name&quot; şirkəti silinsin?');">
              <input type="hidden" name="id" value="@c.Id" />
              <button class="btn-sm danger" type="submit">Sil</button>
            </form>
          }
        </div>
      </div>
    }
    @if (Model.Companies.Count == 0) { <p class="hint" style="padding:14px 22px">Hələ şirkət əlavə edilməyib.</p> }
  </div>
</section>
}

<div class="param-grid">
  <!-- Şöbələr -->
  <section class="panel">
    <div class="param-head"><h3>Şöbələr</h3></div>
    @if (canAdd)
    {
      <form asp-action="AddDepartment" method="post" class="device-form device-add">
        <div class="fld grow"><label>Şöbə adı</label><input name="name" type="text" placeholder="Mühasibatlıq" required /></div>
        <div class="fld md"><label>Şirkət</label>
          <select name="companyId" required>
            @foreach (var c in Model.Companies) { <option value="@c.Id">@c.Name</option> }
          </select>
        </div>
        <div class="fld md"><label>Ana şöbə</label>
          <select name="parentId">
            <option value="">— Yoxdur —</option>
            @foreach (var d in Model.Departments) { <option value="@d.Id">@d.Name</option> }
          </select>
        </div>
        <div class="fld end"><button class="btn btn-primary" type="submit">Əlavə et</button></div>
      </form>
    }
    <div>
      @foreach (var d in Model.Departments)
      {
        <div class="param-item">
          <div class="param-item-info">
            <b>@d.Name</b>
            <span>@d.CompanyName@(d.ParentName != null ? " · " + d.ParentName : "") · <span class="@(d.IsActive ? "st-on" : "st-off")">@(d.IsActive ? "Aktiv" : "Deaktiv")</span></span>
          </div>
          <div class="host-actions">
            @if (canEdit)
            {
              <form asp-action="ToggleDepartment" method="post" style="display:inline">
                <input type="hidden" name="id" value="@d.Id" />
                <button class="btn-sm outline" type="submit">@(d.IsActive ? "Deaktiv et" : "Aktiv et")</button>
              </form>
            }
            @if (canDelete)
            {
              <form asp-action="DeleteDepartment" method="post" style="display:inline"
                    onsubmit="return confirm('&quot;@d.Name&quot; şöbəsi silinsin?');">
                <input type="hidden" name="id" value="@d.Id" />
                <button class="btn-sm danger" type="submit">Sil</button>
              </form>
            }
          </div>
        </div>
      }
    </div>
  </section>

  <!-- Vəzifələr -->
  <section class="panel">
    <div class="param-head"><h3>Vəzifələr</h3></div>
    @if (canAdd)
    {
      <form asp-action="AddPosition" method="post" class="device-form device-add">
        <div class="fld grow"><label>Vəzifə adı</label><input name="name" type="text" placeholder="Mühasib" required /></div>
        <div class="fld md"><label>Şirkət</label>
          <select name="companyId" required>
            @foreach (var c in Model.Companies) { <option value="@c.Id">@c.Name</option> }
          </select>
        </div>
        <div class="fld end"><button class="btn btn-primary" type="submit">Əlavə et</button></div>
      </form>
    }
    <div>
      @foreach (var p in Model.Positions)
      {
        <div class="param-item">
          <div class="param-item-info">
            <b>@p.Name</b>
            <span>@p.CompanyName · <span class="@(p.IsActive ? "st-on" : "st-off")">@(p.IsActive ? "Aktiv" : "Deaktiv")</span></span>
          </div>
          <div class="host-actions">
            @if (canEdit)
            {
              <form asp-action="TogglePosition" method="post" style="display:inline">
                <input type="hidden" name="id" value="@p.Id" />
                <button class="btn-sm outline" type="submit">@(p.IsActive ? "Deaktiv et" : "Aktiv et")</button>
              </form>
            }
            @if (canDelete)
            {
              <form asp-action="DeletePosition" method="post" style="display:inline"
                    onsubmit="return confirm('&quot;@p.Name&quot; vəzifəsi silinsin?');">
                <input type="hidden" name="id" value="@p.Id" />
                <button class="btn-sm danger" type="submit">Sil</button>
              </form>
            }
          </div>
        </div>
      }
    </div>
  </section>
</div>

<!-- Qəbul edən şəxslər -->
<section class="panel">
  <div class="param-head"><h3>Qəbul edən şəxslər</h3></div>
  @if (canAdd)
  {
    <form asp-action="AddHost" method="post" class="host-add">
      <input name="firstName" type="text" placeholder="Ad" required />
      <input name="lastName" type="text" placeholder="Soyad" required />
      <input name="email" type="email" placeholder="Email" />
      <input name="phone" type="text" placeholder="Telefon" />
      <input name="department" type="text" placeholder="Şöbə/vəzifə" />
      <button class="btn btn-primary" type="submit">Əlavə et</button>
    </form>
  }

  <div>
    @foreach (var h in Model.Hosts)
    {
      var fid = $"h{h.Id}";
      <div class="host-row">
        <form id="@fid" asp-action="UpdateHost" method="post" style="display:none"><input type="hidden" name="id" value="@h.Id" /></form>
        <input class="cell-input" form="@fid" name="firstName" value="@h.FirstName" placeholder="Ad" @(canEdit ? "" : "readonly") />
        <input class="cell-input" form="@fid" name="lastName" value="@h.LastName" placeholder="Soyad" @(canEdit ? "" : "readonly") />
        <input class="cell-input" form="@fid" name="email" value="@h.Email" placeholder="Email" @(canEdit ? "" : "readonly") />
        <input class="cell-input" form="@fid" name="phone" value="@h.Phone" placeholder="Telefon" @(canEdit ? "" : "readonly") />
        <input class="cell-input" form="@fid" name="department" value="@h.Department" placeholder="Şöbə/vəzifə" @(canEdit ? "" : "readonly") />
        <div class="host-actions">
          @if (canEdit)
          {
            <button class="btn-sm dark" type="submit" form="@fid">Yadda saxla</button>
            <form asp-action="ToggleHost" method="post" style="display:inline">
              <input type="hidden" name="id" value="@h.Id" />
              <button class="btn-sm @(h.IsActive ? "ok" : "muted")" type="submit">@(h.IsActive ? "Aktiv" : "Deaktiv")</button>
            </form>
          }
          @if (canDelete)
          {
            <form asp-action="DeleteHost" method="post" style="display:inline"
                  onsubmit="return confirm('&quot;@h.FirstName @h.LastName&quot; qəbul edəni silinsin?');">
              <input type="hidden" name="id" value="@h.Id" />
              <button class="btn-sm danger" type="submit">Sil</button>
            </form>
          }
        </div>
      </div>
    }
  </div>
</section>

<div class="param-grid">
  <!-- Gəliş məqsədləri -->
  <section class="panel">
    <div class="param-head"><h3>Gəliş məqsədləri</h3></div>
    @if (canAdd)
    {
      <form asp-action="AddPurpose" method="post" class="param-add">
        <input name="name" type="text" placeholder="Yeni məqsəd" required />
        <button class="btn btn-primary" type="submit">Əlavə et</button>
      </form>
    }
    <div>
      @foreach (var p in Model.Purposes)
      {
        <div class="param-item">
          <div class="param-item-info">
            <b>@p.Name</b>
            <span class="@(p.IsActive ? "st-on" : "st-off")">@(p.IsActive ? "Aktiv" : "Deaktiv")</span>
          </div>
          <div class="host-actions">
            @if (canEdit)
            {
              <form asp-action="TogglePurpose" method="post" style="display:inline">
                <input type="hidden" name="id" value="@p.Id" />
                <button class="btn-sm outline" type="submit">@(p.IsActive ? "Deaktiv et" : "Aktiv et")</button>
              </form>
            }
            @if (canDelete)
            {
              <form asp-action="DeletePurpose" method="post" style="display:inline"
                    onsubmit="return confirm('&quot;@p.Name&quot; məqsədi silinsin?');">
                <input type="hidden" name="id" value="@p.Id" />
                <button class="btn-sm danger" type="submit">Sil</button>
              </form>
            }
          </div>
        </div>
      }
    </div>
  </section>

  <!-- Mərtəbələr -->
  <section class="panel">
    <div class="param-head"><h3>Mərtəbələr</h3></div>
    @if (canAdd)
    {
      <form asp-action="AddFloor" method="post" class="device-form device-add">
        <div class="fld grow"><label>Mərtəbə adı</label><input name="name" type="text" placeholder="1-ci mərtəbə" required /></div>
        <div class="fld md"><label>Mərkəz</label>
          <select name="centerId">
            <option value="">— Mərkəz seç —</option>
            @foreach (var c in Model.Centers) { <option value="@c.Id">@c.Name</option> }
          </select>
        </div>
        <div class="fld end"><button class="btn btn-primary" type="submit">Əlavə et</button></div>
      </form>
    }
    <div>
      @foreach (var f in Model.Floors)
      {
        <div class="param-item">
          <div class="param-item-info">
            <b>@f.Name</b>
            <span>@(f.CenterName ?? "Mərkəzsiz") · @f.DeviceCount cihaz · <span class="@(f.IsActive ? "st-on" : "st-off")">@(f.IsActive ? "Aktiv" : "Deaktiv")</span></span>
          </div>
          <div class="host-actions">
            @if (canEdit)
            {
              <form asp-action="ToggleFloor" method="post" style="display:inline">
                <input type="hidden" name="id" value="@f.Id" />
                <button class="btn-sm outline" type="submit">@(f.IsActive ? "Deaktiv et" : "Aktiv et")</button>
              </form>
            }
            @if (canDelete)
            {
              <form asp-action="DeleteFloor" method="post" style="display:inline"
                    onsubmit="return confirm('&quot;@f.Name&quot; mərtəbəsi silinsin?');">
                <input type="hidden" name="id" value="@f.Id" />
                <button class="btn-sm danger" type="submit">Sil</button>
              </form>
            }
          </div>
        </div>
      }
    </div>
  </section>
</div>

<!-- Cihazlar (Hikvision) -->
<section class="panel">
  <div class="param-head"><h3>Cihazlar (Hikvision)</h3></div>
  <p class="hint" style="margin:0 0 4px">Hər mərtəbənin giriş və çıxış terminalı. Admin login/parol bütün cihazlar üçün ortaqdır (konfiqurasiyada saxlanır).</p>
  @if (canAdd)
  {
    <form asp-action="AddDevice" method="post" class="device-form device-add">
      <div class="fld grow"><label>Cihaz adı</label><input name="name" type="text" placeholder="1-ci mərtəbə - Giriş" required /></div>
      <div class="fld"><label>IP ünvanı</label><input name="ip" type="text" placeholder="10.130.0.189" required /></div>
      <div class="fld sm"><label>Port</label><input name="port" type="number" value="80" min="1" max="65535" /></div>
      <div class="fld md"><label>Mərtəbə</label>
        <select name="floorId" required>
          <option value="">Seçin</option>
          @foreach (var f in Model.Floors) { <option value="@f.Id">@f.Name</option> }
        </select>
      </div>
      <div class="fld md"><label>İstiqamət</label>
        <select name="direction">
          <option value="Entry">Giriş</option>
          <option value="Exit">Çıxış</option>
        </select>
      </div>
      <div class="fld md"><label title="Status məntiqi bundan asılıdır">Keçid tipi</label>
        <select name="pointType">
          <option value="Door">Adi qapı</option>
          <option value="MainEntrance">Əsas giriş (→ Binadadır)</option>
          <option value="FloorEntrance">Mərtəbə girişi (→ Mərtəbədə)</option>
          <option value="MainExit">Əsas çıxış (→ Çıxıb)</option>
          <option value="FloorExit">Mərtəbə çıxışı</option>
          <option value="Turnstile">Turniket</option>
        </select>
      </div>
      <div class="fld sm"><label title="Cihazdakı qapı nömrəsi — tək qapılı terminalda 1 qalır">Qapı №</label><input name="doorNo" type="number" value="1" min="1" title="Cihazdakı qapı nömrəsi. Tək qapılı terminalda 1 saxlanılır." /></div>
      <div class="fld chk"><label>HTTPS</label><input name="useHttps" type="checkbox" value="true" /></div>
      <div class="fld end"><button class="btn btn-primary" type="submit">Əlavə et</button></div>
    </form>
  }

  <div>
    @foreach (var d in Model.Devices)
    {
      var did = $"d{d.Id}";
      <div class="device-form device-row">
        <form id="@did" asp-action="UpdateDevice" method="post" style="display:none"><input type="hidden" name="id" value="@d.Id" /></form>
        <div class="fld grow"><input form="@did" name="name" value="@d.Name" @(canEdit ? "" : "readonly") /></div>
        <div class="fld"><input form="@did" name="ip" value="@d.Ip" @(canEdit ? "" : "readonly") /></div>
        <div class="fld sm"><input form="@did" name="port" type="number" value="@d.Port" @(canEdit ? "" : "readonly") /></div>
        <div class="fld md">
          <select form="@did" name="floorId" @(canEdit ? "" : "disabled")>
            @foreach (var f in Model.Floors)
            {
              if (f.Id == d.FloorId) { <option value="@f.Id" selected>@f.Name</option> }
              else { <option value="@f.Id">@f.Name</option> }
            }
          </select>
        </div>
        <div class="fld md">
          <select form="@did" name="direction" @(canEdit ? "" : "disabled")>
            <option value="Entry" selected="@(d.Direction == "Entry")">Giriş</option>
            <option value="Exit" selected="@(d.Direction == "Exit")">Çıxış</option>
          </select>
        </div>
        <div class="fld md">
          <select form="@did" name="pointType" @(canEdit ? "" : "disabled")>
            <option value="Door" selected="@(d.PointType == "Door")">Adi qapı</option>
            <option value="MainEntrance" selected="@(d.PointType == "MainEntrance")">Əsas giriş</option>
            <option value="FloorEntrance" selected="@(d.PointType == "FloorEntrance")">Mərtəbə girişi</option>
            <option value="MainExit" selected="@(d.PointType == "MainExit")">Əsas çıxış</option>
            <option value="FloorExit" selected="@(d.PointType == "FloorExit")">Mərtəbə çıxışı</option>
            <option value="Turnstile" selected="@(d.PointType == "Turnstile")">Turniket</option>
          </select>
        </div>
        <div class="fld sm"><input form="@did" name="doorNo" type="number" value="@d.DoorNo" @(canEdit ? "" : "readonly") /></div>
        <div class="fld chk"><input form="@did" name="useHttps" type="checkbox" value="true" checked="@d.UseHttps" @(canEdit ? "" : "disabled") /></div>
        <div class="host-actions">
          @if (canEdit)
          {
            <button class="btn-sm dark" type="submit" form="@did">Yadda saxla</button>
            <form asp-action="ToggleDevice" method="post" style="display:inline">
              <input type="hidden" name="id" value="@d.Id" />
              <button class="btn-sm @(d.IsActive ? "ok" : "muted")" type="submit">@(d.IsActive ? "Aktiv" : "Deaktiv")</button>
            </form>
          }
          @if (canDelete)
          {
            <form asp-action="DeleteDevice" method="post" style="display:inline"
                  onsubmit="return confirm('&quot;@d.Name&quot; cihazı silinsin?');">
              <input type="hidden" name="id" value="@d.Id" />
              <button class="btn-sm danger" type="submit">Sil</button>
            </form>
          }
        </div>
      </div>
    }
    @if (Model.Devices.Count == 0)
    {
      <p class="hint" style="padding:14px 22px">Hələ cihaz əlavə edilməyib.</p>
    }
  </div>
</section>
