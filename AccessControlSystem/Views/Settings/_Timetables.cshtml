@using AccessControlSystem.Application.DTOs
@using AccessControlSystem.Filters
@using System.Text
@using Microsoft.AspNetCore.Html
@model SettingsViewModel
@*  Parametrlər → "İş cədvəlləri" tabı. Əməliyyatlar TimetablesController-dədir
    və "set_timetables" bölmə icazəsi ilə işləyir.  *@
@{
    var companies = Model.Companies;
    var schedules = Model.WorkSchedules;
    var isGlobalAdmin = ViewData["IsGlobalAdmin"] as bool? ?? false;

    var access = ViewData["Access"] as Dictionary<string, SectionAccessDto> ?? new();
    var acc = access.TryGetValue(Sections.Timetables, out var ttA) ? ttA : new SectionAccessDto();
    var canAdd = acc.CanAdd;
    var canEdit = acc.CanEdit;
    var canDelete = acc.CanDelete;

    // 24-saatlıq vaxt seçici: gizli input (name) + saat/dəqiqə dropdown-ları.
    // required=false → boş ("—") seçim mümkündür (opsional pəncərələr üçün).
    Func<string, string, string, bool, IHtmlContent> TimeField = (label, name, value, required) =>
    {
        var hh = value.Length >= 2 ? value.Substring(0, 2) : "";
        var mm = value.Length == 5 ? value.Substring(3, 2) : "00";
        var sb = new StringBuilder();
        sb.Append($"<div class=\"tt-fld\"><label>{label}</label><div class=\"tt-time\">");
        sb.Append($"<input type=\"hidden\" name=\"{name}\" id=\"{name}\" value=\"{value}\" />");
        sb.Append($"<select id=\"{name}_h\" onchange=\"ttSyncTime('{name}')\">");
        if (!required) sb.Append($"<option value=\"\"{(hh == "" ? " selected" : "")}>—</option>");
        for (int h = 0; h < 24; h++)
        {
            var hs = h.ToString("00");
            sb.Append($"<option value=\"{hs}\"{(hs == hh ? " selected" : "")}>{hs}</option>");
        }
        sb.Append("</select><span class=\"tt-colon\">:</span>");
        sb.Append($"<select id=\"{name}_m\" onchange=\"ttSyncTime('{name}')\">");
        for (int m = 0; m < 60; m++)
        {
            var ms = m.ToString("00");
            sb.Append($"<option value=\"{ms}\"{(ms == mm ? " selected" : "")}>{ms}</option>");
        }
        sb.Append("</select></div></div>");
        return new HtmlString(sb.ToString());
    };
}

<div class="tt-wrap">
  @if (canAdd)
  {
    <section class="panel tt-form-panel">
      <div class="param-head"><h3 id="ttFormTitle">Yeni iş cədvəli</h3></div>
      <form asp-controller="Timetables" asp-action="Add" method="post" id="ttForm" class="tt-form">
        <input type="hidden" name="id" id="ttId" value="" />

        <div class="tt-group">
          <span class="tt-group-title">Əsas</span>
          <div class="tt-grid">
            <div class="tt-fld tt-span2"><label>Ad</label><input name="Name" id="ttName" type="text" placeholder="Standart 09:00–18:00" required /></div>
            @if (isGlobalAdmin)
            {
              <div class="tt-fld"><label>Şirkət</label>
                <select name="CompanyId" id="ttCompany">
                  <option value="">Qlobal (hamıya)</option>
                  @foreach (var co in companies) { <option value="@co.Id">@co.Name</option> }
                </select>
              </div>
            }
          </div>
        </div>

        <div class="tt-group">
          <span class="tt-group-title">İş saatları</span>
          <div class="tt-grid">
            @TimeField("Başlama", "StartTime", "09:00", true)
            @TimeField("Bitmə", "EndTime", "18:00", true)
            <div class="tt-fld"><label>İcazəli gecikmə (dəq)</label><input name="GraceMinutes" id="ttGrace" type="number" min="0" max="240" value="0" /></div>
            <div class="tt-fld"><label>İcazəli erkən çıxış (dəq)</label><input name="EarlyLeaveGraceMinutes" id="ttEarly" type="number" min="0" max="240" value="0" /></div>
          </div>
        </div>

        <div class="tt-group">
          <span class="tt-group-title">Gün başlanğıcı (oxutma sərhədi)</span>
          <div class="tt-grid">
            @TimeField("Gün başlanğıcı", "DayStart", "05:00", true)
          </div>
          <p class="hint">İştirak günü bu vaxtdan növbəti gün eyni vaxta qədərdir. Girişlər bu vaxtdan oxunur, çıxışlar növbəti sərhədə qədər. Məs. <b>05:00</b> → gecə 00:17 oxutması ƏVVƏLKİ günə düşür, bugünkü hesaba qarışmır.</p>
        </div>

        <div class="tt-group">
          <span class="tt-group-title">İş günləri</span>
          <div class="tt-days">
            <label><input type="checkbox" name="Mon" id="ttMon" value="true" checked /> B.e</label>
            <label><input type="checkbox" name="Tue" id="ttTue" value="true" checked /> Ç.a</label>
            <label><input type="checkbox" name="Wed" id="ttWed" value="true" checked /> Ç</label>
            <label><input type="checkbox" name="Thu" id="ttThu" value="true" checked /> C.a</label>
            <label><input type="checkbox" name="Fri" id="ttFri" value="true" checked /> C</label>
            <label><input type="checkbox" name="Sat" id="ttSat" value="true" /> Ş</label>
            <label><input type="checkbox" name="Sun" id="ttSun" value="true" /> B</label>
          </div>
          <p class="hint">Dinamik günlər: işçi yalnız müəyyən günlər işləyirsə (məs. B.e/Ç/C), o günləri işarələnmiş ayrıca cədvəl yaradıb ona təyin et.</p>
        </div>

        <div class="tt-actions">
          <button class="btn btn-primary" type="submit" id="ttSubmit">Əlavə et</button>
          <button class="btn btn-outline" type="button" id="ttCancel" style="display:none" onclick="ttReset()">Ləğv et</button>
        </div>
      </form>
    </section>
  }

  <section class="panel">
    <div class="param-head"><h3>Mövcud cədvəllər (@schedules.Count)</h3></div>
    <div>
      @foreach (var s in schedules)
      {
        var win = $" · Gün başlanğıcı: {s.DayStart}";
        <div class="param-item">
          <div class="param-item-info">
            <b>@s.Name <span style="color:var(--faint);font-weight:500">(@s.StartTime–@s.EndTime)</span></b>
            <span>@s.CompanyName · Günlər: @s.DaysLabel · Gecikmə: @s.GraceMinutes/@s.EarlyLeaveGraceMinutes dəq@(win) · @s.UsageCount təyinat · <span class="@(s.IsActive ? "st-on" : "st-off")">@(s.IsActive ? "Aktiv" : "Deaktiv")</span></span>
          </div>
          <div class="host-actions">
            @if (canEdit)
            {
              <button class="btn-sm outline" type="button" onclick="ttEdit(@s.Id)">Redaktə</button>
              <form asp-controller="Timetables" asp-action="Toggle" method="post" style="display:inline">
                <input type="hidden" name="id" value="@s.Id" />
                <button class="btn-sm outline" type="submit">@(s.IsActive ? "Deaktiv et" : "Aktiv et")</button>
              </form>
            }
            @if (canDelete)
            {
              <form asp-controller="Timetables" asp-action="Delete" method="post" style="display:inline"
                    onsubmit="return confirm('&quot;@s.Name&quot; iş cədvəli silinsin?');">
                <input type="hidden" name="id" value="@s.Id" />
                <button class="btn-sm danger" type="submit">Sil</button>
              </form>
            }
          </div>
        </div>
      }
      @if (schedules.Count == 0)
      {
        <p class="hint" style="padding:14px 22px">Hələ iş cədvəli əlavə edilməyib.</p>
      }
    </div>
  </section>
</div>

<style>
  .tt-wrap { display:flex; flex-direction:column; gap:18px; }
  .tt-form { padding:6px 24px 22px; }
  .tt-group { padding:16px 0; border-top:1px solid var(--line, #eef0f4); }
  .tt-group:first-child { border-top:none; padding-top:8px; }
  .tt-group-title { display:block; font-size:11.5px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--faint,#9095a1); margin-bottom:12px; }
  .tt-group-title em { font-style:normal; font-weight:500; text-transform:none; opacity:.75; }
  .tt-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:16px; }
  .tt-fld { display:flex; flex-direction:column; gap:6px; min-width:0; }
  .tt-fld label { font-size:12.5px; font-weight:600; color:var(--ink,#3a4152); }
  /* Bütün input/select-ə vahid modern görünüş — brauzer defoltu yox */
  .tt-fld input, .tt-fld select {
    width:100%; box-sizing:border-box; height:40px; padding:0 12px;
    border:1px solid var(--line,#dde1e8); border-radius:10px; background:#fff;
    font-size:14px; color:var(--ink,#2b303b); outline:none; transition:border-color .15s, box-shadow .15s;
  }
  .tt-fld select { padding-right:8px; cursor:pointer; }
  .tt-fld input:focus, .tt-fld select:focus { border-color:#3b82f6; box-shadow:0 0 0 3px rgba(59,130,246,.15); }
  .tt-time { display:flex; align-items:center; gap:6px; }
  .tt-time select { flex:1 1 0; min-width:0; padding:0 6px; text-align:center; }
  .tt-colon { color:var(--faint,#9095a1); font-weight:700; }
  .tt-fld input[type=time]::-webkit-calendar-picker-indicator { opacity:.5; cursor:pointer; }
  .tt-span2 { grid-column:span 2; }
  .tt-color input { padding:4px; cursor:pointer; }
  .tt-days { display:flex; flex-wrap:wrap; gap:8px; }
  .tt-days label { display:inline-flex; align-items:center; gap:7px; font-weight:500; cursor:pointer;
    padding:8px 14px; border:1px solid var(--line,#dde1e8); border-radius:9px; background:#fff; font-size:13.5px; user-select:none; }
  .tt-days label:has(input:checked) { border-color:#3b82f6; background:#eff5ff; color:#1d4ed8; font-weight:600; }
  .tt-days input { accent-color:#3b82f6; }
  .tt-actions { display:flex; gap:10px; padding-top:18px; }
  .tt-dot { display:inline-block; width:11px; height:11px; border-radius:3px; margin-right:7px; vertical-align:middle; box-shadow:0 0 0 1px rgba(0,0,0,.06); }
  .tt-form-panel .param-head h3 { margin:0; }
  @@media (max-width: 640px) { .tt-span2 { grid-column:span 1; } }
</style>
<script>
  var TT_DATA = @Html.Raw(Json.Serialize(schedules));
  function ttEdit(id) {
    var s = TT_DATA.find(function (x) { return x.id === id; }); if (!s) return;
    var f = document.getElementById('ttForm'); if (!f) return;
    f.setAttribute('action', '@Url.Action("Update", "Timetables")');
    var g = i => document.getElementById(i);
    g('ttId').value = s.id;
    g('ttName').value = s.name || '';
    ttSetTime('StartTime', s.startTime || '09:00');
    ttSetTime('EndTime', s.endTime || '18:00');
    g('ttGrace').value = s.graceMinutes || 0;
    g('ttEarly').value = s.earlyLeaveGraceMinutes || 0;
    ttSetTime('DayStart', s.dayStart || '05:00');
    if (g('ttCompany')) g('ttCompany').value = s.companyId || '';
    ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach(function (d) { g('tt' + d).checked = !!s[d.toLowerCase()]; });
    g('ttFormTitle').textContent = 'İş cədvəlini redaktə et';
    g('ttSubmit').textContent = 'Yadda saxla';
    g('ttCancel').style.display = '';
    document.getElementById('ttForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function ttReset() {
    var f = document.getElementById('ttForm'); if (!f) return;
    f.setAttribute('action', '@Url.Action("Add", "Timetables")');
    document.getElementById('ttId').value = '';
    f.reset();
    // vaxt seçicilərini defolt/boşa qaytar
    ttSetTime('StartTime', '09:00');
    ttSetTime('EndTime', '18:00');
    ttSetTime('DayStart', '05:00');
    document.getElementById('ttFormTitle').textContent = 'Yeni iş cədvəli';
    document.getElementById('ttSubmit').textContent = 'Əlavə et';
    document.getElementById('ttCancel').style.display = 'none';
  }
  // Saat/dəqiqə dropdown-larından gizli "HH:mm" input-u qur (boş saat = boş dəyər).
  function ttSyncTime(name) {
    var h = document.getElementById(name + '_h'), m = document.getElementById(name + '_m');
    var hid = document.getElementById(name);
    if (!h || !m || !hid) return;
    hid.value = (h.value === '') ? '' : (h.value + ':' + m.value);
  }
  // Gizli dəyərdən ("HH:mm" və ya boş) dropdown-ları doldur.
  function ttSetTime(name, val) {
    var h = document.getElementById(name + '_h'), m = document.getElementById(name + '_m');
    var hid = document.getElementById(name);
    if (!h || !m || !hid) return;
    if (!val) { h.value = ''; m.value = '00'; } else { var p = val.split(':'); h.value = p[0]; m.value = p[1] || '00'; }
    ttSyncTime(name);
  }
</script>
