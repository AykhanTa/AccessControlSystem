@model HistoryViewModel
@{
    ViewData["Title"] = "Giriş-çıxış tarixçəsi";
    ViewData["Heading"] = "Giriş-çıxış tarixçəsi";
    ViewData["Active"] = "history";
    var from = Model.From?.ToString("yyyy-MM-dd");
    var to = Model.To?.ToString("yyyy-MM-dd");

    string LogoutIcon() => "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4\"/><polyline points=\"16 17 21 12 16 7\"/><line x1=\"21\" y1=\"12\" x2=\"9\" y2=\"12\"/></svg>";
    string CardIcon() => "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\"/><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"/></svg>";
    string QrIcon() => "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/><line x1=\"17.5\" y1=\"14\" x2=\"17.5\" y2=\"21\"/><line x1=\"14\" y1=\"17.5\" x2=\"21\" y2=\"17.5\"/></svg>";
}

<div class="page-head">
  <div class="hist-title">
    <span class="hist-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
    <p>Giriş-çıxış məlumatları cədvəli.</p>
  </div>
  <button class="btn btn-ghost no-print" id="btnPrintHist" type="button">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
    Tarixçəni çap et
  </button>
</div>

<section class="panel">
  <form method="get" class="hist-filters no-print">
    <div class="search hist-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="histSearch" type="text" placeholder="Tarixçədə axtar" />
    </div>
    <input name="from" type="date" value="@from" />
    <input name="to" type="date" value="@to" />
    <button class="btn btn-dark" type="submit">Axtar</button>
  </form>

  <div class="hist-count" id="histCount">@Model.Items.Count tarixçə qeydi</div>
  <div class="history-list" id="histRows">
    @if (!Model.Items.Any())
    {
      <div style="text-align:center;color:#9aa4b3;padding:24px">Seçilmiş aralıqda tarixçə qeydi tapılmadı.</div>
    }
    @foreach (var h in Model.Items)
    {
      var pass = h.PassType == "qr" ? "QR kod" : (h.CardNo ?? "—");
      <div class="history-row" data-search="@((h.Name + " " + h.Doc + " " + pass + " " + h.Host + " " + h.Area + " " + h.Purpose).ToLower())">
        <div class="hist-exit-ico">@Html.Raw(LogoutIcon())</div>
        <div class="hist-who">
          @ViewHelpers.Avatar(h.Photo, h.Name)
          <div class="g-name"><b>@h.Name</b><span>@h.Doc</span></div>
        </div>
        <div class="hist-col">
          <div class="hist-main">@h.Host</div>
          <div class="hist-sub">
            @if (h.PassType == "qr")
            {
              <span class="pass-tag qr" title="QR kod">@Html.Raw(QrIcon())</span>
            }
            else
            {
              <span class="pass-tag card" title="Kart">@Html.Raw(CardIcon())</span>
            }
            @pass
          </div>
        </div>
        <div class="hist-col">
          <div class="hist-main">@h.Area</div>
          <div class="hist-sub">@h.Purpose</div>
        </div>
        <div class="hist-col ta-right">
          <div class="hist-main">@h.Arrival</div>
          <div class="hist-sub">Çıxış: @h.Exit</div>
        </div>
      </div>
    }
  </div>
</section>

@section Scripts {
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var search = document.getElementById('histSearch');
      var count = document.getElementById('histCount');
      if (search) {
        search.addEventListener('input', function (e) {
          var q = e.target.value.trim().toLowerCase();
          var shown = 0;
          document.querySelectorAll('#histRows .history-row').forEach(function (row) {
            var ok = (row.dataset.search || '').includes(q);
            row.style.display = ok ? '' : 'none';
            if (ok) shown++;
          });
          if (count) count.textContent = shown + ' tarixçə qeydi';
        });
      }
      document.getElementById('btnPrintHist')?.addEventListener('click', function () { window.print(); });
    });
  </script>
}
