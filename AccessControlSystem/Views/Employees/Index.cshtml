@model EmployeesViewModel
@{
    ViewData["Title"] = "İşçilər";
    ViewData["Heading"] = "İşçilər";
    ViewData["Active"] = "employees";
    var canAdd = ViewData["CanAdd"] as bool? ?? false;
    var canEdit = ViewData["CanEdit"] as bool? ?? false;
    var canDelete = ViewData["CanDelete"] as bool? ?? false;
    var today = DateTime.Today.ToString("yyyy-MM-dd");

    string EditIcon() => "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"/><path d=\"M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z\"/></svg>";

    (string, string) St(string s) => s switch
    {
        "active" => ("Aktiv", "in"),
        "terminated" => ("İşdən çıxıb", "late"),
        _ => ("Deaktiv", "out")
    };
    (string, string) Fs(string s) => s switch
    {
        "synced" => ("Üz sinxron", "in"),
        "pending" => ("Üz gözləyir", "checkedin"),
        "failed" => ("Üz xəta", "late"),
        _ => ("Üz", "out")
    };
    (string, string) Pr(string s) => s switch
    {
        "in" => ("Binadadır", "in"),
        "onfloor" => ("Mərtəbədə", "onfloor"),
        _ => ("Çıxış etdi", "out")
    };
}

<style>
  .emp-toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
  .emp-toolbar .input{height:40px;padding:0 12px;border-radius:10px}
  .emp-toolbar #fDept{width:170px}
  .emp-toolbar #fEmpSearch{width:230px;max-width:52vw}
  .emp-toolbar .btn{height:40px;white-space:nowrap}
</style>

<div class="page-head">
  <div><p>Daimi işçilər — şirkət/şöbə/vəzifə, üz və icazəli mərtəbələr.</p></div>
  <div class="emp-toolbar">
    <select id="fDept" class="input" title="Şöbəyə görə süz">
      <option value="">Bütün şöbələr</option>
      @foreach (var d in Model.Departments)
      {
        <option value="@d.Name">@d.Name</option>
      }
    </select>
    <input type="text" id="fEmpSearch" class="input" placeholder="Ad / İD axtar…" />
    @if (canAdd)
    {
      <button class="btn btn-primary" id="btnNewEmp" type="button">+ Yeni işçi</button>
    }
  </div>
</div>

<section class="panel">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Ad Soyad</th><th>Şirkət / Şöbə</th><th>Vəzifə</th><th>Telefon</th>
          <th>Mərtəbələr</th><th>Hazırda</th><th>Status</th><th>Üz</th><th>Əməliyyatlar</th>
        </tr>
      </thead>
      <tbody id="empRows">
        @foreach (var e in Model.Employees)
        {
          var st = St(e.Status);
          var fs = Fs(e.FaceStatus);
          var pr = Pr(e.Presence);
          <tr data-empid="@e.Id" data-dept="@e.Department" data-search="@(((e.Name ?? "") + " " + (e.EmployeeNo ?? "")).ToLower())">
            <td>
              <div class="who-cell">
                @ViewHelpers.Avatar(e.Photo, e.Name)
                <div class="g-name"><b>@e.Name</b><span>@e.EmployeeNo</span></div>
              </div>
            </td>
            <td class="cell-sub">@e.Company@(e.Department != null ? " · " + e.Department : "")</td>
            <td class="cell-sub">@(e.Position ?? "—")</td>
            <td class="cell-sub">@(e.Phone ?? "—")</td>
            <td class="cell-sub cell-multi">@(string.IsNullOrEmpty(e.Floors) ? "—" : e.Floors)</td>
            <td class="js-presence"><span class="chip @pr.Item2">@pr.Item1</span>@(e.LastSeen != null ? Html.Raw($"<div class='hint js-lastseen' style='font-size:11px;margin-top:3px'>{e.LastSeen}</div>") : Html.Raw("<div class='hint js-lastseen' style='font-size:11px;margin-top:3px'></div>"))</td>
            <td><span class="chip @st.Item2">@st.Item1</span></td>
            <td><span class="chip @fs.Item2">@fs.Item1</span></td>
            <td>
              <div class="row-actions">
                @if (canEdit)
                {
                  <button class="act-btn edit js-emp-edit" title="Redaktə et" type="button" data-id="@e.Id">@Html.Raw(EditIcon())</button>
                  <form asp-action="Sync" method="post" style="display:inline"
                        onsubmit="return confirm('@e.Name cihazlara yazılsın (üz + icazə)?');">
                    <input type="hidden" name="id" value="@e.Id" />
                    <button class="btn-sm dark" type="submit" title="Cihazlara yaz + üz yüklə">Cihaza göndər</button>
                  </form>
                  <form asp-action="ToggleStatus" method="post" style="display:inline">
                    <input type="hidden" name="id" value="@e.Id" />
                    <button class="btn-sm @(e.Status == "active" ? "ok" : "muted")" type="submit">@(e.Status == "active" ? "Aktiv" : "Deaktiv")</button>
                  </form>
                }
                @if (canDelete)
                {
                  <form asp-action="Delete" method="post" style="display:inline"
                        onsubmit="return confirm('@e.Name işçisi silinsin?');">
                    <input type="hidden" name="id" value="@e.Id" />
                    <button class="btn-sm danger" type="submit">Sil</button>
                  </form>
                }
              </div>
            </td>
          </tr>
        }
        @if (Model.Employees.Count == 0)
        {
          <tr><td colspan="9" class="hint" style="padding:22px;text-align:center">Hələ işçi əlavə edilməyib.</td></tr>
        }
      </tbody>
    </table>
  </div>
  <div id="empNoMatch" class="hint" style="display:none;padding:22px;text-align:center">Filtrə uyğun işçi tapılmadı.</div>
  <div id="empPager" style="display:none;justify-content:space-between;align-items:center;padding:12px 16px;border-top:1px solid var(--border,#e5e7eb);flex-wrap:wrap;gap:10px">
    <div style="display:flex;align-items:center;gap:8px">
      <span class="hint" id="empCount" style="color:var(--muted)"></span>
      <select id="empPageSize" class="input" style="width:auto;height:34px">
        <option value="15">15</option><option value="30">30</option><option value="50">50</option>
      </select>
    </div>
    <div style="display:flex;align-items:center;gap:6px">
      <button class="btn btn-sm" type="button" id="empPrev">‹</button>
      <span id="empPageLbl" style="font-size:13px;min-width:80px;text-align:center"></span>
      <button class="btn btn-sm" type="button" id="empNext">›</button>
    </div>
  </div>
</section>

<!-- ============ İŞÇİ MODALI ============ -->
<div class="modal-overlay" id="empModal">
  <form class="modal" id="empForm" asp-action="Create" method="post" enctype="multipart/form-data">
    <input type="hidden" name="Id" id="empId" value="0" />
    <div class="modal-head">
      <h2 id="empModalTitle">Yeni işçi</h2>
      <button class="modal-close" id="empClose" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="modal-body">
      <div class="form-col">
        <div class="col-title">Şəxsi məlumatlar</div>
        <div class="field"><label>Ad <span class="req">*</span></label><input name="FirstName" id="eFirst" type="text" required /></div>
        <div class="field"><label>Soyad <span class="req">*</span></label><input name="LastName" id="eLast" type="text" required /></div>
        <div class="field"><label>Ata adı</label><input name="Patronymic" id="ePat" type="text" /></div>
        <div class="field"><label>FİN</label><input name="FinCode" id="eFin" type="text" placeholder="7 simvol" /></div>
        <div class="field"><label>Sənəd nömrəsi</label><input name="DocumentNo" id="eDoc" type="text" /></div>
      </div>
      <div class="form-col">
        <div class="col-title">Təşkilat və əlaqə</div>
        <div class="field"><label>İşçi İD</label><input name="EmployeeNo" id="eNo" type="text" placeholder="Boş olsa avtomatik" /></div>
        <div class="field">
          <label>Şirkət <span class="req">*</span></label>
          <select name="CompanyId" id="eCompany" required>
            @foreach (var c in Model.Companies) { <option value="@c.Id">@c.Name</option> }
          </select>
        </div>
        <div class="field">
          <label>Şöbə</label>
          <select name="DepartmentId" id="eDept">
            <option value="" data-company="">— Yoxdur —</option>
            @foreach (var d in Model.Departments) { <option value="@d.Id" data-company="@d.CompanyId">@d.Name</option> }
          </select>
        </div>
        <div class="field">
          <label>Vəzifə</label>
          <select name="PositionId" id="ePos">
            <option value="" data-company="">— Yoxdur —</option>
            @foreach (var p in Model.Positions) { <option value="@p.Id" data-company="@p.CompanyId">@p.Name</option> }
          </select>
        </div>
        <div class="field"><label>Telefon</label><input name="Phone" id="ePhone" type="text" /></div>
        <div class="field"><label>Email</label><input name="Email" id="eEmail" type="email" /></div>
      </div>
      <div class="form-col">
        <div class="col-title">İcazə və şəkil</div>
        <div class="field"><label>İşə qəbul tarixi</label><input name="EmploymentStartAt" id="eStart" type="date" value="@today" /></div>
        <div class="field">
          <label>İcazəli mərtəbələr</label>
          <select name="FloorIds" id="eFloors" multiple size="5">
            @foreach (var f in Model.Floors) { <option value="@f.Id">@f.Name</option> }
          </select>
          <small class="hint">Ctrl (⌘) ilə bir neçəsini seçin.</small>
        </div>
        <div class="field">
          <label>Şəkil (üz tanıma üçün)</label>
          <input name="Photo" id="ePhoto" type="file" accept="image/*" />
          <small class="hint">Aydın portret — cihaza üz kimi yüklənəcək.</small>
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-ghost" id="empCancel" type="button">Ləğv et</button>
      <button class="btn btn-primary" type="submit" id="empSubmit">Yadda saxla</button>
    </div>
  </form>
</div>

@section Scripts {
  <script>
    var EMPLOYEES = @Html.Raw(Json.Serialize(Model.Employees));

    // Şöbə + ad/tabel filtri + client-side pagination
    (function () {
      var dept = document.getElementById('fDept');
      var search = document.getElementById('fEmpSearch');
      var pager = document.getElementById('empPager');
      var noMatch = document.getElementById('empNoMatch');
      var empPage = 1;
      var empPageSize = 15;

      function matchedRows() {
        var d = (dept?.value || '');
        var q = (search?.value || '').trim().toLowerCase();
        return Array.prototype.filter.call(
          document.querySelectorAll('#empRows tr[data-empid]'),
          function (tr) {
            var okDept = !d || tr.getAttribute('data-dept') === d;
            var okSearch = !q || (tr.getAttribute('data-search') || '').indexOf(q) !== -1;
            return okDept && okSearch;
          });
      }

      function render() {
        var all = document.querySelectorAll('#empRows tr[data-empid]');
        Array.prototype.forEach.call(all, function (tr) { tr.style.display = 'none'; });

        var matches = matchedRows();
        var total = matches.length;
        var totalPages = Math.max(1, Math.ceil(total / empPageSize));
        if (empPage > totalPages) empPage = totalPages;
        if (empPage < 1) empPage = 1;

        var start = (empPage - 1) * empPageSize;
        matches.slice(start, start + empPageSize).forEach(function (tr) { tr.style.display = ''; });

        if (noMatch) noMatch.style.display = (total === 0 && all.length > 0) ? 'block' : 'none';
        if (pager) {
          pager.style.display = total > empPageSize ? 'flex' : (total > 0 ? 'flex' : 'none');
          document.getElementById('empCount').textContent = total + ' işçi';
          document.getElementById('empPageLbl').textContent = empPage + ' / ' + totalPages;
          document.getElementById('empPrev').disabled = empPage <= 1;
          document.getElementById('empNext').disabled = empPage >= totalPages;
        }
      }

      function reset() { empPage = 1; render(); }

      dept?.addEventListener('change', reset);
      search?.addEventListener('input', reset);
      document.getElementById('empPageSize')?.addEventListener('change', function () {
        empPageSize = parseInt(this.value, 10) || 15; reset();
      });
      document.getElementById('empPrev')?.addEventListener('click', function () { empPage--; render(); });
      document.getElementById('empNext')?.addEventListener('click', function () { empPage++; render(); });

      render();
    })();

    // Seçilmiş şirkətə görə Şöbə/Vəzifə seçimlərini süz (kaskad).
    function filterEmpOrg() {
      var g = id => document.getElementById(id);
      var cid = g('eCompany').value;
      ['eDept', 'ePos'].forEach(function (selId) {
        var sel = g(selId);
        var hideSelected = false;
        Array.from(sel.options).forEach(function (o) {
          var oc = o.getAttribute('data-company') || '';
          var show = (oc === '' || oc === cid);
          o.hidden = !show;
          o.disabled = !show;
          if (!show && o.selected) hideSelected = true;
        });
        if (hideSelected) sel.value = '';
      });
    }

    function openEmp(edit, e) {
      var form = document.getElementById('empForm');
      var g = id => document.getElementById(id);
      document.getElementById('empModalTitle').textContent = edit ? 'İşçini redaktə et' : 'Yeni işçi';
      form.setAttribute('action', edit ? '/Employees/Update' : '/Employees/Create');
      form.reset();
      // multiselect-i təmizlə
      Array.from(g('eFloors').options).forEach(o => o.selected = false);

      if (edit && e) {
        g('empId').value = e.id;
        g('eFirst').value = e.firstName || '';
        g('eLast').value = e.lastName || '';
        g('ePat').value = e.patronymic || '';
        g('eFin').value = e.finCode || '';
        g('eDoc').value = e.documentNo || '';
        g('eNo').value = e.employeeNo || '';
        g('ePhone').value = e.phone || '';
        g('eEmail').value = e.email || '';
        g('eCompany').value = e.companyId || '';
        filterEmpOrg();                       // şöbə/vəzifəni şirkətə görə süz
        g('eDept').value = e.departmentId || '';
        g('ePos').value = e.positionId || '';
        if (e.employmentStartAt) g('eStart').value = e.employmentStartAt;
        (e.floorIds || []).forEach(fid => {
          var opt = g('eFloors').querySelector('option[value="' + fid + '"]');
          if (opt) opt.selected = true;
        });
      } else {
        g('empId').value = 0;
        filterEmpOrg();                       // yeni işçi — default şirkətə görə süz
      }
      document.getElementById('empModal').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeEmp() {
      document.getElementById('empModal').classList.remove('open');
      document.body.style.overflow = '';
    }

    document.addEventListener('DOMContentLoaded', function () {
      document.getElementById('eCompany')?.addEventListener('change', filterEmpOrg);
      document.getElementById('btnNewEmp')?.addEventListener('click', function () { openEmp(false); });
      document.getElementById('empClose')?.addEventListener('click', closeEmp);
      document.getElementById('empCancel')?.addEventListener('click', closeEmp);
      document.getElementById('empModal')?.addEventListener('click', function (ev) { if (ev.target.id === 'empModal') closeEmp(); });
      document.getElementById('empRows')?.addEventListener('click', function (ev) {
        var btn = ev.target.closest('.js-emp-edit');
        if (!btn) return;
        var e = (EMPLOYEES || []).find(x => String(x.id) === btn.dataset.id);
        openEmp(true, e);
      });
      document.addEventListener('keydown', function (ev) { if (ev.key === 'Escape') closeEmp(); });

      // Canlı mövqe yeniləmə (refresh olmadan)
      if (document.getElementById('empRows')) setInterval(pollPresence, 5000);
    });

    var PRES = {
      in:      { label: 'Binadadır', cls: 'in' },
      onfloor: { label: 'Mərtəbədə', cls: 'onfloor' },
      out:     { label: 'Çıxış etdi', cls: 'out' }
    };
    async function pollPresence() {
      try {
        var res = await fetch('/Employees/StatusFeed', { headers: { 'X-Requested-With': 'fetch' } });
        if (!res.ok) return;
        var list = await res.json();
        list.forEach(function (item) {
          var tr = document.querySelector('#empRows tr[data-empid="' + item.id + '"]');
          if (!tr) return;
          var cell = tr.querySelector('.js-presence');
          if (!cell) return;
          var p = PRES[item.presence] || PRES.out;
          var chip = cell.querySelector('.chip');
          if (chip && chip.textContent !== p.label) {
            chip.textContent = p.label;
            chip.className = 'chip ' + p.cls;
          }
          var ls = cell.querySelector('.js-lastseen');
          if (ls && item.lastSeen) ls.textContent = item.lastSeen;
        });
      } catch (e) { /* növbəti dövrədə */ }
    }
  </script>
}
